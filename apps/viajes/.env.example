# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local al repositorio.
# En producción estas variables se cargan en Vercel (Settings → Environment Variables).

# Administración (/admin). La contraseña nunca va en el código.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GoatCounter: código del sitio (lo que va antes de .goatcounter.com) y clave de API con permiso de lectura.
GOATCOUNTER_CODE=
GOATCOUNTER_API_TOKEN=

# Asistente con IA (Claude)
ANTHROPIC_API_KEY=

# Fase 3: APIs de viajes
SERPAPI_API_KEY=
LITEAPI_API_KEY=
OPENWEATHER_API_KEY=
AERODATABOX_RAPIDAPI_KEY=
