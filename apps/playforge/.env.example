# URL pública del sitio (para SEO, sitemap y vistas previas al compartir)
NEXT_PUBLIC_SITIO_URL=https://playforge.example.com

# Base de datos Postgres (Neon, Supabase, Vercel Postgres...). Sin esto se usa un archivo local (sólo para pruebas).
DATABASE_URL=

# IA del Creador (Claude). Sin clave, el Creador usa el generador rápido local.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5)
MODELO_IA=
# Límite de gasto mensual en la API de IA, en dólares (Creador + juego diario)
LIMITE_GASTO_IA_USD=25
# Generaciones con IA por persona por día
GENERACIONES_IA_POR_DIA=25
