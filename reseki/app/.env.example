# ─────────────────────────────────────────────────────────────
# Reseki — variables de entorno
# Copia este archivo como .env.local (en local) o cárgalas en
# Vercel → Project → Settings → Environment Variables.
# NUNCA subas los valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO en el servidor. Salta la seguridad por filas (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Modo demo: "true" usa reseñas de ejemplo; "false" usa Google Business Profile real.
RESEKI_DEMO_MODE=true

# Anthropic (IA que escribe las respuestas). Sin clave se usa una plantilla de demostración.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-opus-5-5)
# RESEKI_AI_MODEL=claude-opus-5-5

# Secreto para la revisión periódica (Vercel Cron). Cualquier texto largo y aleatorio.
CRON_SECRET=

# ─── Fases siguientes (aún no se usan) ───
# TOKEN_ENCRYPTION_KEY=          # 32 bytes en base64 para cifrar los tokens de Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# RESEND_API_KEY=
# ALERT_EMAIL=pascualpepa@icloud.com
